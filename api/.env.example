# Copy to .env (gitignored) and fill in. Loaded by Spring at startup via
# spring.config.import in application.yml. In CI/prod, set these as real
# environment variables instead.

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Sign-in (Google OIDC). Without these, login is disabled but the AI endpoints work.
# Create a Google OAuth 2.0 Web client; authorized redirect URI:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional model overrides (OpenRouter model slugs). Defaults live in application.yml.
# HELPDOIT_CHAT_MODEL=openai/gpt-4o-mini
# HELPDOIT_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional per-task overrides (both default to HELPDOIT_CHAT_MODEL when unset):
#   FAST  = ask-path latency (grading/reformulation/expansion) — set faster to speed up search
#   SMART = walkthrough summarization + vision — set stronger (e.g. openai/gpt-4o) for better summaries
# HELPDOIT_FAST_MODEL=google/gemini-2.0-flash-001
# HELPDOIT_SMART_MODEL=openai/gpt-4o

# Optionally disable user file attachments instance-wide (default true).
# HELPDOIT_ATTACHMENTS_ENABLED=false
